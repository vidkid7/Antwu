# Node 24.12+; use an absolute persistent path in production.
ANTWU_DB_PATH="/var/lib/antwu/antwu.sqlite"
NEXT_PUBLIC_SITE_URL="https://antwu.org.np"
# Only enable behind a trusted reverse proxy that overwrites X-Real-IP.
TRUST_PROXY="true"
# Optional initial administrator setup values (setup never resets an existing user).
ADMIN_EMAIL="admin@antwu.org.np"
# Supply ADMIN_INITIAL_PASSWORD only during setup, or use generated credentials.
